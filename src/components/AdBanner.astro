---
interface Ad {
	id: string;
	title: string;
	imageUrl: string;
	linkUrl: string;
	position: 'header' | 'sidebar' | 'in-article' | 'footer';
}

interface Props {
	position: Ad['position'];
	maxAds?: number;
}

const { position, maxAds = 1 } = Astro.props;
---

<script is:inline>
	(function () {
		const position = document.currentScript?.dataset?.position;
		const maxAds = parseInt(document.currentScript?.dataset?.maxAds || '1', 10);
		const container = document.getElementById(`ads-${position}`);
		if (!container) return;

		const dismissed = JSON.parse(localStorage.getItem('dismissedAds') || '[]');

		async function loadAds() {
			try {
				const res = await fetch('/api/ads');
				if (!res.ok) return;
				const ads = await res.json();
				const filtered = ads
					.filter((a) => a.position === position && !dismissed.includes(a.id))
					.slice(0, maxAds);
				if (filtered.length === 0) {
					container.style.display = 'none';
					return;
				}
				container.innerHTML = filtered
					.map(
						(ad) => `
					<div class="ad-banner" data-ad-id="${ad.id}" style="position:relative;margin:1rem 0;border-radius:8px;overflow:hidden;border:1px solid #e5e7eb;">
						<a href="${ad.linkUrl}" target="_blank" rel="noopener noreferrer" style="display:block;text-decoration:none;color:inherit;">
							<img src="${ad.imageUrl}" alt="${ad.title}" style="width:100%;height:auto;display:block;" loading="lazy" />
						</a>
						<button
							type="button"
							class="ad-dismiss"
							aria-label="Cerrar aviso"
							style="position:absolute;top:6px;right:6px;width:28px;height:28px;border-radius:50%;background:rgba(0,0,0,0.6);color:white;border:none;cursor:pointer;font-size:16px;line-height:1;display:flex;align-items:center;justify-content:center;z-index:10;"
						>
							&times;
						</button>
					</div>
				`
					)
					.join('');

				container.querySelectorAll('.ad-dismiss').forEach((btn) => {
					btn.addEventListener('click', (e) => {
						e.preventDefault();
						e.stopPropagation();
						const banner = btn.closest('.ad-banner');
						if (!banner) return;
						const id = banner.dataset.adId;
						dismissed.push(id);
						localStorage.setItem('dismissedAds', JSON.stringify(dismissed));
						banner.remove();
						if (!container.querySelector('.ad-banner')) container.style.display = 'none';
					});
				});
			} catch (e) {
				console.error('Error cargando avisos:', e);
			}
		}

		loadAds();
	})();
</script>

<div id={`ads-${position}`} style="display:block;"></div>